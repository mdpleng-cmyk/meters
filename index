<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
<title>MDPL Meter Readings</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  body { -webkit-tap-highlight-color: transparent; }
  input[type=number]::-webkit-inner-spin-button,
  input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .toast { animation: slideUp .25s ease-out, fadeOut .3s ease-in 2.2s forwards; }
  @keyframes slideUp { from { transform: translateY(20px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
  @keyframes fadeOut { to { opacity: 0 } }
  .pin-dot { width: 14px; height: 14px; border-radius: 9999px; border: 2px solid #94a3b8; }
  .pin-dot.filled { background: #0f172a; border-color: #0f172a; }
</style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800">

<!-- ============ LOGIN SCREEN ============ -->
<div id="login-screen" class="min-h-screen flex flex-col items-center justify-center p-6">
  <div class="w-full max-w-sm">
    <h1 class="text-2xl font-bold text-center mb-1">MDPL Meter Readings</h1>
    <p class="text-center text-slate-500 mb-6" id="login-subtitle">Tap your name to sign in</p>

    <div id="operator-picker" class="grid grid-cols-2 gap-3"></div>

    <div id="pin-pad-screen" class="hidden">
      <button id="pin-back-btn" class="text-slate-500 mb-4 flex items-center gap-1">&larr; Back</button>
      <p class="text-center text-lg font-semibold mb-4" id="pin-operator-name"></p>
      <div class="flex justify-center gap-3 mb-6" id="pin-dots"></div>
      <div class="grid grid-cols-3 gap-3" id="pin-keys"></div>
    </div>

    <p id="login-error" class="hidden text-red-600 text-sm text-center mt-4"></p>
  </div>
</div>

<!-- ============ MAIN APP ============ -->
<div id="main-app" class="hidden min-h-screen">
  <header class="bg-white border-b sticky top-0 z-10">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
      <div>
        <p class="font-semibold" id="header-name"></p>
        <p class="text-xs text-slate-500" id="header-role"></p>
      </div>
      <div class="flex items-center gap-2">
        <div class="flex bg-slate-100 rounded-lg p-1" id="tab-switch">
          <button data-tab="entry" class="tab-btn px-3 py-1.5 rounded-md text-sm font-medium">Entry</button>
          <button data-tab="dashboard" id="dashboard-tab-btn" class="tab-btn px-3 py-1.5 rounded-md text-sm font-medium hidden">Dashboard</button>
        </div>
        <button id="logout-btn" class="text-slate-400 text-sm px-2">Exit</button>
      </div>
    </div>
  </header>

  <!-- ---------- OPERATOR ENTRY VIEW ---------- -->
  <main id="entry-view" class="max-w-md mx-auto p-4 space-y-4">
    <div class="bg-white rounded-xl p-4 shadow-sm space-y-3">
      <div>
        <label class="text-xs font-medium text-slate-500">Shift</label>
        <select id="shift-select" class="w-full mt-1 border rounded-lg p-3 text-base">
          <option>Morning</option>
          <option>Evening</option>
          <option>Night</option>
        </select>
      </div>

      <div class="relative">
        <label class="text-xs font-medium text-slate-500">Meter</label>
        <input id="meter-search" autocomplete="off" placeholder="Search meter code or name..."
          class="w-full mt-1 border rounded-lg p-3 text-base" />
        <div id="meter-dropdown" class="hidden absolute z-20 w-full bg-white border rounded-lg mt-1 max-h-64 overflow-y-auto shadow-lg"></div>
      </div>

      <div id="meter-info" class="hidden bg-slate-50 rounded-lg p-3 text-sm space-y-1">
        <p><span class="text-slate-500">Location:</span> <span id="mi-location"></span></p>
        <p><span class="text-slate-500">Previous reading:</span>
          <span id="mi-previous" class="font-semibold"></span> <span id="mi-unit"></span>
        </p>
      </div>

      <div>
        <label class="text-xs font-medium text-slate-500">New reading</label>
        <input id="reading-input" type="number" inputmode="decimal" step="any" placeholder="0.00"
          class="w-full mt-1 border rounded-lg p-4 text-3xl font-semibold text-center tracking-wide" disabled />
      </div>

      <div id="consumption-box" class="hidden rounded-lg p-3 text-center">
        <p class="text-xs text-slate-500">Consumption</p>
        <p id="consumption-value" class="text-xl font-bold"></p>
        <p id="consumption-warning" class="hidden text-xs text-red-600 mt-1">
          New reading is lower than the previous one — could be a meter reset or replacement. Tap Submit again to confirm.
        </p>
      </div>

      <button id="submit-btn" disabled
        class="w-full bg-slate-300 text-white font-semibold rounded-lg py-3.5 text-base transition-colors">
        Submit Reading
      </button>
    </div>
  </main>

  <!-- ---------- CONTROL ROOM DASHBOARD VIEW ---------- -->
  <main id="dashboard-view" class="hidden max-w-6xl mx-auto p-4 space-y-4">
    <div class="bg-white rounded-xl p-4 shadow-sm">
      <div class="flex flex-wrap gap-3 items-end">
        <div>
          <label class="text-xs font-medium text-slate-500 block">Date</label>
          <input id="filter-date" type="date" class="border rounded-lg p-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-medium text-slate-500 block">Shift</label>
          <select id="filter-shift" class="border rounded-lg p-2 text-sm">
            <option value="">All</option>
            <option>Morning</option>
            <option>Evening</option>
            <option>Night</option>
          </select>
        </div>
        <div>
          <label class="text-xs font-medium text-slate-500 block">Group</label>
          <select id="filter-group" class="border rounded-lg p-2 text-sm">
            <option value="">All</option>
          </select>
        </div>
        <div class="flex-1 min-w-[160px]">
          <label class="text-xs font-medium text-slate-500 block">Search meter</label>
          <input id="filter-search" placeholder="code or name..." class="border rounded-lg p-2 text-sm w-full" />
        </div>
        <button id="export-btn" class="ml-auto bg-slate-800 text-white text-sm font-medium rounded-lg px-4 py-2.5">
          Export CSV
        </button>
      </div>
    </div>

    <div class="bg-white rounded-xl p-4 shadow-sm">
      <h2 class="font-semibold mb-3">Shift Checklist <span class="text-xs font-normal text-slate-400" id="checklist-summary"></span></h2>
      <div id="checklist-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2"></div>
    </div>

    <div class="bg-white rounded-xl p-4 shadow-sm overflow-x-auto">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">Live Readings</h2>
        <span class="flex items-center gap-1.5 text-xs text-emerald-600">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live
        </span>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-slate-500 border-b">
            <th class="py-2 pr-2">Time</th>
            <th class="py-2 pr-2">Meter</th>
            <th class="py-2 pr-2">Location</th>
            <th class="py-2 pr-2">Shift</th>
            <th class="py-2 pr-2">Reading</th>
            <th class="py-2 pr-2">Consumption</th>
            <th class="py-2 pr-2">Operator</th>
          </tr>
        </thead>
        <tbody id="live-table-body"></tbody>
      </table>
      <p id="live-table-empty" class="hidden text-center text-slate-400 py-6">No readings for this filter yet.</p>
    </div>
  </main>
</div>

<div id="toast-container" class="fixed bottom-6 left-0 right-0 flex flex-col items-center gap-2 z-50 pointer-events-none"></div>

<script>
// ============================================================
// CONFIG — replace with your Supabase project credentials
// ============================================================
const SUPABASE_URL = "https://cyycyzwfeswnodpnhpdu.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN5eWN5endmZXN3bm9kcG5ocGR1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcxMjI2MTQsImV4cCI6MjEwMjY5ODYxNH0.WXMde2-K_roIqqhZvcTyi-O_dB1q0HvPzRRMpj6MzN4";
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

// ============================================================
// STATE
// ============================================================
const state = {
  operator: null,        // { id, code, name, role }
  meters: [],
  selectedMeter: null,
  previousReading: null,
  pendingPin: "",
  pinOperator: null,
  confirmingLowReading: false,
  dashboardMetersById: {},
  dashboardChannel: null,
};

// ============================================================
// UTIL
// ============================================================
function toast(msg, kind = "ok") {
  const el = document.createElement("div");
  el.className = `toast pointer-events-auto px-4 py-2.5 rounded-lg shadow-lg text-sm font-medium text-white ${kind === "ok" ? "bg-emerald-600" : "bg-red-600"}`;
  el.textContent = msg;
  document.getElementById("toast-container").appendChild(el);
  setTimeout(() => el.remove(), 2600);
}
function todayStr() { return new Date().toISOString().slice(0, 10); }
function defaultShift() {
  const h = new Date().getHours();
  if (h >= 6 && h < 14) return "Morning";
  if (h >= 14 && h < 22) return "Evening";
  return "Night";
}
function fmtTime(ts) {
  return new Date(ts).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
}

// ============================================================
// LOGIN FLOW
// ============================================================
async function initLogin() {
  const { data: session } = await sb.auth.getSession();
  if (session?.session) {
    const ok = await loadOperatorProfile();
    if (ok) return showMainApp();
  }
  await loadOperatorPicker();
}

async function loadOperatorPicker() {
  const { data, error } = await sb.from("operators").select("id,code,name").eq("active", true).order("name");
  const wrap = document.getElementById("operator-picker");
  wrap.innerHTML = "";
  if (error) { toast("Could not load operator list", "err"); return; }
  data.forEach(op => {
    const btn = document.createElement("button");
    btn.className = "bg-white rounded-xl p-4 shadow-sm text-center font-medium hover:bg-slate-50 active:scale-95 transition";
    btn.textContent = op.name;
    btn.onclick = () => openPinPad(op);
    wrap.appendChild(btn);
  });
}

function openPinPad(op) {
  state.pinOperator = op;
  state.pendingPin = "";
  document.getElementById("operator-picker").classList.add("hidden");
  document.getElementById("login-subtitle").classList.add("hidden");
  document.getElementById("pin-pad-screen").classList.remove("hidden");
  document.getElementById("pin-operator-name").textContent = op.name;
  document.getElementById("login-error").classList.add("hidden");
  renderPinDots();
  const keys = document.getElementById("pin-keys");
  keys.innerHTML = "";
  ["1","2","3","4","5","6","7","8","9","","0","del"].forEach(k => {
    const btn = document.createElement("button");
    if (k === "") { keys.appendChild(document.createElement("div")); return; }
    btn.className = "bg-white rounded-xl py-4 text-xl font-semibold shadow-sm active:scale-95 transition";
    btn.textContent = k === "del" ? "⌫" : k;
    btn.onclick = () => k === "del" ? pinBackspace() : pinDigit(k);
    keys.appendChild(btn);
  });
}

function renderPinDots() {
  const wrap = document.getElementById("pin-dots");
  wrap.innerHTML = "";
  for (let i = 0; i < 4; i++) {
    const d = document.createElement("div");
    d.className = "pin-dot" + (i < state.pendingPin.length ? " filled" : "");
    wrap.appendChild(d);
  }
}

function pinDigit(d) {
  if (state.pendingPin.length >= 4) return;
  state.pendingPin += d;
  renderPinDots();
  if (state.pendingPin.length === 4) attemptLogin();
}
function pinBackspace() {
  state.pendingPin = state.pendingPin.slice(0, -1);
  renderPinDots();
}

document.getElementById("pin-back-btn").onclick = () => {
  document.getElementById("pin-pad-screen").classList.add("hidden");
  document.getElementById("operator-picker").classList.remove("hidden");
  document.getElementById("login-subtitle").classList.remove("hidden");
};

async function attemptLogin() {
  const email = `${state.pinOperator.code.toLowerCase()}@mdpl.local`;
  const { error } = await sb.auth.signInWithPassword({ email, password: state.pendingPin });
  const errEl = document.getElementById("login-error");
  if (error) {
    errEl.textContent = "Incorrect PIN. Try again.";
    errEl.classList.remove("hidden");
    state.pendingPin = "";
    renderPinDots();
    return;
  }
  const ok = await loadOperatorProfile();
  if (ok) showMainApp();
}

async function loadOperatorProfile() {
  const { data: userData } = await sb.auth.getUser();
  if (!userData?.user) return false;
  const { data, error } = await sb.from("operators").select("id,code,name,role").eq("id", userData.user.id).single();
  if (error || !data) { toast("Profile not found for this login", "err"); await sb.auth.signOut(); return false; }
  state.operator = data;
  return true;
}

document.getElementById("logout-btn").onclick = async () => {
  await sb.auth.signOut();
  state.operator = null;
  if (state.dashboardChannel) sb.removeChannel(state.dashboardChannel);
  document.getElementById("main-app").classList.add("hidden");
  document.getElementById("login-screen").classList.remove("hidden");
  document.getElementById("pin-pad-screen").classList.add("hidden");
  document.getElementById("operator-picker").classList.remove("hidden");
  document.getElementById("login-subtitle").classList.remove("hidden");
  loadOperatorPicker();
};

// ============================================================
// MAIN APP SHELL
// ============================================================
async function showMainApp() {
  document.getElementById("login-screen").classList.add("hidden");
  document.getElementById("main-app").classList.remove("hidden");
  document.getElementById("header-name").textContent = state.operator.name;
  document.getElementById("header-role").textContent = state.operator.role === "control_room" ? "Control Room" : "Operator";
  if (state.operator.role === "control_room") {
    document.getElementById("dashboard-tab-btn").classList.remove("hidden");
  }
  setTab("entry");
  document.getElementById("shift-select").value = defaultShift();
  await loadMeters();
}

document.querySelectorAll(".tab-btn").forEach(btn => btn.onclick = () => setTab(btn.dataset.tab));
function setTab(tab) {
  document.getElementById("entry-view").classList.toggle("hidden", tab !== "entry");
  document.getElementById("dashboard-view").classList.toggle("hidden", tab !== "dashboard");
  document.querySelectorAll(".tab-btn").forEach(b => {
    b.classList.toggle("bg-white", b.dataset.tab === tab);
    b.classList.toggle("shadow-sm", b.dataset.tab === tab);
  });
  if (tab === "dashboard") initDashboard();
}

// ============================================================
// OPERATOR ENTRY
// ============================================================
async function loadMeters() {
  const { data, error } = await sb.from("meters").select("*").eq("active", true).order("meter_code");
  if (error) { toast("Could not load meters", "err"); return; }
  state.meters = data;
}

const searchInput = document.getElementById("meter-search");
const dropdown = document.getElementById("meter-dropdown");
searchInput.addEventListener("input", () => {
  const q = searchInput.value.trim().toLowerCase();
  if (!q) { dropdown.classList.add("hidden"); return; }
  const matches = state.meters.filter(m =>
    m.meter_code.toLowerCase().includes(q) || m.name.toLowerCase().includes(q)
  ).slice(0, 8);
  dropdown.innerHTML = "";
  if (matches.length === 0) { dropdown.classList.add("hidden"); return; }
  matches.forEach(m => {
    const row = document.createElement("div");
    row.className = "p-3 hover:bg-slate-50 cursor-pointer border-b last:border-0";
    row.innerHTML = `<p class="font-medium text-sm">${m.meter_code} — ${m.name}</p><p class="text-xs text-slate-400">${m.location || ""}</p>`;
    row.onclick = () => selectMeter(m);
    dropdown.appendChild(row);
  });
  dropdown.classList.remove("hidden");
});
document.addEventListener("click", (e) => {
  if (!e.target.closest("#meter-search") && !e.target.closest("#meter-dropdown")) dropdown.classList.add("hidden");
});

async function selectMeter(m) {
  state.selectedMeter = m;
  searchInput.value = `${m.meter_code} — ${m.name}`;
  dropdown.classList.add("hidden");

  const { data } = await sb.from("latest_meter_readings").select("reading_value").eq("meter_id", m.id).maybeSingle();
  state.previousReading = data ? Number(data.reading_value) : null;

  document.getElementById("meter-info").classList.remove("hidden");
  document.getElementById("mi-location").textContent = m.location || "—";
  document.getElementById("mi-previous").textContent = state.previousReading !== null ? state.previousReading : "No prior reading";
  document.getElementById("mi-unit").textContent = m.unit;

  const input = document.getElementById("reading-input");
  input.disabled = false;
  input.value = "";
  input.focus();
  updateConsumption();
}

const readingInput = document.getElementById("reading-input");
readingInput.addEventListener("input", () => { state.confirmingLowReading = false; updateConsumption(); });

function updateConsumption() {
  const box = document.getElementById("consumption-box");
  const submitBtn = document.getElementById("submit-btn");
  const val = parseFloat(readingInput.value);
  if (isNaN(val) || !state.selectedMeter) {
    box.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.className = "w-full bg-slate-300 text-white font-semibold rounded-lg py-3.5 text-base";
    return;
  }
  const prev = state.previousReading;
  const consumption = prev !== null ? val - prev : 0;
  box.classList.remove("hidden");
  document.getElementById("consumption-value").textContent = `${consumption.toFixed(2)} ${state.selectedMeter.unit}`;
  const warn = document.getElementById("consumption-warning");
  const isLow = prev !== null && val < prev;
  warn.classList.toggle("hidden", !isLow);
  box.className = "rounded-lg p-3 text-center " + (isLow ? "bg-red-50" : "bg-emerald-50");
  submitBtn.disabled = false;
  submitBtn.textContent = isLow && !state.confirmingLowReading ? "Reading lower than previous — tap to confirm" : "Submit Reading";
  submitBtn.className = "w-full font-semibold rounded-lg py-3.5 text-base transition-colors text-white " +
    (isLow && !state.confirmingLowReading ? "bg-amber-500" : "bg-slate-800");
}

document.getElementById("submit-btn").onclick = async () => {
  const val = parseFloat(readingInput.value);
  if (isNaN(val) || !state.selectedMeter) return;
  const prev = state.previousReading;
  const isLow = prev !== null && val < prev;

  if (isLow && !state.confirmingLowReading) {
    state.confirmingLowReading = true;
    updateConsumption();
    return;
  }

  const submitBtn = document.getElementById("submit-btn");
  submitBtn.disabled = true;
  submitBtn.textContent = "Saving...";

  const { error } = await sb.from("meter_readings").insert({
    meter_id: state.selectedMeter.id,
    reading_value: val,
    recorded_by: state.operator.id,
    shift: document.getElementById("shift-select").value,
    reading_date: todayStr(),
    notes: isLow ? "possible reset/replacement — confirmed by operator" : null,
  });

  if (error) {
    toast("Save failed: " + error.message, "err");
    submitBtn.disabled = false;
    updateConsumption();
    return;
  }

  toast(`Saved ✓ ${state.selectedMeter.meter_code}`);
  state.confirmingLowReading = false;
  state.selectedMeter = null;
  state.previousReading = null;
  searchInput.value = "";
  readingInput.value = "";
  readingInput.disabled = true;
  document.getElementById("meter-info").classList.add("hidden");
  document.getElementById("consumption-box").classList.add("hidden");
  submitBtn.disabled = true;
  submitBtn.textContent = "Submit Reading";
  submitBtn.className = "w-full bg-slate-300 text-white font-semibold rounded-lg py-3.5 text-base";
  searchInput.focus();
};

// ============================================================
// CONTROL ROOM DASHBOARD
// ============================================================
async function initDashboard() {
  document.getElementById("filter-date").value = todayStr();

  const groups = [...new Set(state.meters.map(m => m.meter_group).filter(Boolean))];
  const groupSel = document.getElementById("filter-group");
  groupSel.innerHTML = '<option value="">All</option>' + groups.map(g => `<option>${g}</option>`).join("");

  ["filter-date", "filter-shift", "filter-group", "filter-search"].forEach(id => {
    document.getElementById(id).addEventListener("input", refreshDashboard);
  });
  document.getElementById("export-btn").onclick = exportCsv;

  await refreshDashboard();
  subscribeRealtime();
}

function currentFilters() {
  return {
    date: document.getElementById("filter-date").value,
    shift: document.getElementById("filter-shift").value,
    group: document.getElementById("filter-group").value,
    search: document.getElementById("filter-search").value.trim().toLowerCase(),
  };
}

let lastRows = [];

async function refreshDashboard() {
  const f = currentFilters();
  let query = sb.from("meter_readings")
    .select("id, reading_value, consumption, shift, reading_date, recorded_at, notes, meters(meter_code,name,location,unit,meter_group), operators(name)")
    .eq("reading_date", f.date)
    .order("recorded_at", { ascending: false });
  if (f.shift) query = query.eq("shift", f.shift);

  const { data, error } = await query;
  if (error) { toast("Dashboard load failed", "err"); return; }

  lastRows = data.filter(r => {
    if (f.group && r.meters?.meter_group !== f.group) return false;
    if (f.search) {
      const hay = `${r.meters?.meter_code} ${r.meters?.name}`.toLowerCase();
      if (!hay.includes(f.search)) return false;
    }
    return true;
  });

  renderLiveTable(lastRows);
  renderChecklist(f);
}

function renderLiveTable(rows) {
  const body = document.getElementById("live-table-body");
  const empty = document.getElementById("live-table-empty");
  body.innerHTML = "";
  empty.classList.toggle("hidden", rows.length > 0);
  rows.forEach(r => {
    const tr = document.createElement("tr");
    tr.className = "border-b last:border-0";
    tr.innerHTML = `
      <td class="py-2 pr-2 text-slate-500">${fmtTime(r.recorded_at)}</td>
      <td class="py-2 pr-2 font-medium">${r.meters?.meter_code || ""}</td>
      <td class="py-2 pr-2">${r.meters?.location || ""}</td>
      <td class="py-2 pr-2">${r.shift}</td>
      <td class="py-2 pr-2">${r.reading_value} ${r.meters?.unit || ""}</td>
      <td class="py-2 pr-2 ${r.consumption < 0 ? "text-red-600" : ""}">${r.consumption}</td>
      <td class="py-2 pr-2">${r.operators?.name || ""}</td>
    `;
    body.appendChild(tr);
  });
}

function renderChecklist(f) {
  const grid = document.getElementById("checklist-grid");
  grid.innerHTML = "";
  const readMeterIds = new Set(lastRows.map(r => r.meters?.meter_code));
  let readCount = 0;
  const visibleMeters = state.meters.filter(m => !f.group || m.meter_group === f.group);
  visibleMeters.forEach(m => {
    const isRead = readMeterIds.has(m.meter_code);
    if (isRead) readCount++;
    const card = document.createElement("div");
    card.className = `rounded-lg p-3 border ${isRead ? "bg-emerald-50 border-emerald-200" : "bg-slate-50 border-slate-200"}`;
    card.innerHTML = `
      <p class="text-sm font-medium">${m.meter_code}</p>
      <p class="text-xs text-slate-500 truncate">${m.name}</p>
      <p class="text-xs mt-1 ${isRead ? "text-emerald-600" : "text-slate-400"}">${isRead ? "✓ Read" : "Pending"}</p>
    `;
    grid.appendChild(card);
  });
  document.getElementById("checklist-summary").textContent = `${readCount} / ${visibleMeters.length} read`;
}

function subscribeRealtime() {
  if (state.dashboardChannel) return;
  state.dashboardChannel = sb.channel("meter_readings_live")
    .on("postgres_changes", { event: "*", schema: "public", table: "meter_readings" }, () => {
      refreshDashboard();
    })
    .subscribe();
}

function exportCsv() {
  if (lastRows.length === 0) { toast("Nothing to export", "err"); return; }
  const headers = ["Time","Meter Code","Meter Name","Location","Shift","Reading","Unit","Consumption","Operator","Notes"];
  const lines = [headers.join(",")];
  lastRows.forEach(r => {
    const row = [
      new Date(r.recorded_at).toLocaleString(),
      r.meters?.meter_code, r.meters?.name, r.meters?.location, r.shift,
      r.reading_value, r.meters?.unit, r.consumption, r.operators?.name, r.notes || "",
    ].map(v => `"${String(v ?? "").replace(/"/g, '""')}"`);
    lines.push(row.join(","));
  });
  const blob = new Blob([lines.join("\n")], { type: "text/csv" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = `meter-readings-${currentFilters().date}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

